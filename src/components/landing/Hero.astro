---
import ArrowIcon from "@/assets/icons/arrow-right.svg";
import ExternalIcon from "@/assets/icons/arrow-up-right.svg";
import Mark from "@/components/brand/Mark.astro";
import { site } from "@/lib/site";

const code = [
  ['<span class="t-kw">const</span> res = <span class="t-kw">await</span> fetch(<span class="t-str">"https://mail.example.com/emails"</span>, {'],
  ['  method: <span class="t-str">"POST"</span>,'],
  ["  headers: {"],
  ['    Authorization: <span class="t-str">`Bearer ${Bun.env.BUNZZLE_KEY}`</span>,'],
  ['    <span class="t-str">"Idempotency-Key"</span>: <span class="t-str">"order-42"</span>,'],
  ["  },"],
  ["  body: JSON.stringify({"],
  ['    from: <span class="t-str">"Shop &lt;hello@example.com&gt;"</span>,'],
  ['    to: [<span class="t-str">"ana@example.org"</span>, <span class="t-str">"ben@example.net"</span>,'],
  ['         <span class="t-str">"cleo@example.com"</span>, <span class="t-str">"dan@example.io"</span>],'],
  ['    subject: <span class="t-str">"Your order has shipped"</span>,'],
  ['    html: <span class="t-str">"&lt;p&gt;It is on its way.&lt;/p&gt;"</span>,'],
  ["  }),"],
  ["});"],
];

const rows = [
  ["ana@example.org", "delivered", "mx1.example.org · TLS 1.3 · 250 2.0.0 OK"],
  ["ben@example.net", "delivered", "mx.example.net · TLS 1.3 · 250 OK"],
  ["cleo@example.com", "delayed", "421 4.7.0 try again later · retrying"],
  ["dan@example.io", "delivered", "mail.example.io · TLS 1.2 · 250 OK"],
];
---

<section class="lh">
  <div class="lh-inner">
    <div class="lh-top">
      <h1 class="lh-title">Email infrastructure <br />you run yourself.</h1>
      <p class="lh-lede">
        <span>A complete delivery engine with reputation built in.</span>{" "}
        <span>One binary, no external database, open source.</span>
      </p>
      <div class="lh-actions">
        <a class="btn btn-primary" href="/docs/">
          Get started
          <ArrowIcon width={16} height={16} aria-hidden="true" />
        </a>
        <a class="btn btn-ghost" href={site.repo}>Star on GitHub</a>
      </div>
    </div>

    <div class="stage" data-stage>
      <div class="art" aria-hidden="true">
        <span class="blob b1"></span>
        <span class="blob b2"></span>
        <span class="blob b3"></span>
        <span class="grain"></span>
      </div>

      <div class="rabbit" style="--depth: 6">
        <Mark />
      </div>

      <div class="window w-code" style="--depth: 14">
        <div class="window-bar">send.ts</div>
        <div class="well">
          <pre class="code">{code.map(([l]) => <span class="ln" set:html={l} />)}</pre>
        </div>
      </div>

      <div class="window w-term" style="--depth: 10">
        <div class="window-bar">Terminal</div>
        <div class="well">
          <pre class="term"><span><span class="t-mute">$</span> sudo bunzzle doctor</span><span><span class="t-ok">[ok]</span>   EHLO name: <span class="t-mute">mail.example.com</span></span><span><span class="t-ok">[ok]</span>   DKIM self-check: <span class="t-mute">verifies against live DNS</span></span><span><span class="t-ok">[ok]</span>   DMARC: <span class="t-mute">TXT _dmarc.example.com is correct</span></span><span class="t-mute">11 ok, 0 warnings, 0 problems<span class="caret"></span></span></pre>
        </div>
      </div>

      <div class="window w-status" style="--depth: 22">
        <div class="window-bar">Delivery</div>
        <div class="well list">
          {rows.map(([to, state, detail], i) => (
            <div class:list={["row", { active: i === 0 }]}>
              <span class:list={["dot", state]}></span>
              <span class="to">{to}</span>
              <span class="detail">{detail}</span>
            </div>
          ))}
        </div>
        <a class="status-foot" href="/docs/api/">
          Every attempt, with MX, TLS and the full SMTP conversation
          <ExternalIcon width={12} height={12} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  if (stage && matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let raf = 0;
    stage.addEventListener("pointermove", (e) => {
      const r = stage.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width) * 2 - 1;
      const y = ((e.clientY - r.top) / r.height) * 2 - 1;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        stage.style.setProperty("--px", x.toFixed(3));
        stage.style.setProperty("--py", y.toFixed(3));
      });
    });
    stage.addEventListener("pointerleave", () => {
      stage.style.setProperty("--px", "0");
      stage.style.setProperty("--py", "0");
    });
  }
</script>

<style>
  .lh {
    --lh-left: 44px;
    --lh-right: 32px;
    position: relative;
    padding-bottom: 72px;
    overflow: hidden;
  }
  .lh-inner {
    max-width: 1728px;
    margin: 0 auto;
    padding: clamp(120px, 16vh, 176px) var(--lh-right) 0 var(--lh-left);
  }
  .lh-top {
    display: grid;
    grid-template-areas: "title lede" "actions lede";
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 64px;
    animation: rise 1.1s var(--ease-out) both;
  }
  .lh-title {
    grid-area: title;
    margin: 0;
    color: var(--ink);
    font-size: clamp(32px, 2.9vw, 54px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.036em;
  }
  .lh-lede {
    grid-area: lede;
    align-self: end;
    margin: 0 0 -0.28em;
    color: var(--muted);
    font-size: clamp(15px, 1.1vw, 18px);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }
  .lh-lede span {
    display: block;
    white-space: nowrap;
  }
  .lh-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }
  .stage {
    --px: 0;
    --py: 0;
    position: relative;
    height: clamp(560px, 52vw, 820px);
    margin-top: clamp(28px, calc(10vh - 52px), 52px);
    overflow: hidden;
    border-radius: 8px;
    isolation: isolate;
    animation: rise 1.2s var(--ease-out) 0.12s both;
  }
  .stage::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }
  :global(:root[data-theme="light"]) .stage::after {
    box-shadow: inset 0 0 0 1px rgba(24, 22, 15, 0.05);
  }
  .art {
    position: absolute;
    inset: -4%;
    background: var(--bg-deep);
    transform: translate(calc(var(--px) * -12px), calc(var(--py) * -9px));
    transition: transform 0.6s var(--ease-out);
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .b1 {
    width: 55%;
    height: 70%;
    left: 30%;
    top: 30%;
    background: radial-gradient(closest-side, #f0a830, transparent);
  }
  .b2 {
    width: 45%;
    height: 60%;
    left: 55%;
    top: -10%;
    background: radial-gradient(closest-side, #ff8a65, transparent);
    animation-duration: 22s;
    animation-delay: -6s;
  }
  .b3 {
    width: 40%;
    height: 55%;
    left: 5%;
    top: 45%;
    background: radial-gradient(closest-side, #e11d48, transparent);
    opacity: 0.35;
    animation-duration: 26s;
    animation-delay: -12s;
  }
  :global(:root[data-theme="light"]) .blob {
    opacity: 0.35;
  }
  .grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dots) 1px, transparent 1.4px);
    background-size: 16px 16px;
  }
  @keyframes drift {
    to {
      transform: translate(8%, -6%) scale(1.12);
    }
  }
  .window,
  .rabbit {
    position: absolute;
    z-index: 2;
    transform: translate(calc(var(--px) * var(--depth) * 1px), calc(var(--py) * var(--depth) * 1px));
    transition: transform 0.6s var(--ease-out);
  }
  .window {
    animation: window-in 1s var(--ease-out) both;
  }
  .w-code {
    top: clamp(32px, calc(11.4vh - 66px), 72px);
    left: 6%;
    width: clamp(520px, 44vw, 760px);
    animation-delay: 0.36s;
  }
  .w-term {
    top: calc(clamp(32px, calc(11.4vh - 66px), 72px) + 40px);
    right: 5%;
    width: clamp(400px, 30vw, 520px);
    animation-delay: 0.68s;
  }
  .w-status {
    top: calc(clamp(32px, calc(11.4vh - 66px), 72px) + 270px);
    right: 16%;
    z-index: 3;
    width: clamp(380px, 31vw, 540px);
    animation-delay: 0.52s;
  }
  .code {
    font-size: clamp(12.5px, 0.75vw, 14px);
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 13px;
    margin-left: 4px;
    vertical-align: -2px;
    background: var(--ink);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .list {
    padding: 6px;
  }
  .row {
    display: grid;
    grid-template-columns: 10px minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 10px;
    border-radius: 8px;
    font-size: 13px;
  }
  .row.active {
    background: var(--row-active);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .delivered {
    background: #5cc787;
  }
  .delayed {
    background: var(--honey-2);
  }
  .to {
    color: var(--ink);
    font-weight: 500;
  }
  .detail {
    overflow: hidden;
    color: var(--faint);
    font: 11.5px var(--font-code);
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .status-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    margin-top: 6px;
    padding-left: 12px;
    color: var(--muted);
    font-size: 12px;
  }
  .status-foot:hover {
    color: var(--ink);
  }
  .rabbit {
    right: 4%;
    bottom: 5%;
    animation: fade 1.4s var(--ease-out) 0.9s both;
  }
  .rabbit :global(.mark) {
    width: clamp(130px, 12vw, 200px);
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.35));
  }
  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(16px);
    }
  }
  @keyframes window-in {
    from {
      opacity: 0;
      translate: 0 22px;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 1100px) {
    .w-code {
      width: 62%;
    }
    .w-term {
      width: 46%;
    }
    .w-status {
      right: 8%;
      width: 56%;
    }
  }
  @media (max-width: 768px) {
    .lh {
      --lh-left: 22px;
      --lh-right: 22px;
      padding-bottom: 48px;
    }
    .lh-top {
      grid-template-areas: "title" "lede" "actions";
      grid-template-columns: minmax(0, 1fr);
    }
    .lh-title br {
      display: none;
    }
    .lh-lede {
      margin: 16px 0 0;
    }
    .lh-lede span {
      display: inline;
      white-space: normal;
    }
    .lh-actions {
      flex-direction: column;
      margin-top: 24px;
    }
    .lh-actions .btn {
      width: 100%;
    }
    .stage {
      display: grid;
      place-items: center;
      height: auto;
      min-height: 300px;
      margin-top: 32px;
      padding: 40px 16px;
    }
    .window {
      display: none;
    }
    .rabbit {
      position: relative;
      inset: auto;
      transform: none;
    }
    .rabbit :global(.mark) {
      width: 160px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lh-top,
    .stage,
    .window,
    .rabbit,
    .blob {
      animation: none;
    }
  }
</style>
