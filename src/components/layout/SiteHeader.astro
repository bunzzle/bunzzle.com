---
import ChevronIcon from "@/assets/icons/arrow-up-right.svg";
import BlueskyIcon from "@/assets/icons/bluesky.svg";
import GithubIcon from "@/assets/icons/github.svg";
import MoonIcon from "@/assets/icons/moon.svg";
import SearchIcon from "@/assets/icons/search.svg";
import SunIcon from "@/assets/icons/sun.svg";
import XIcon from "@/assets/icons/x.svg";
import Logo from "@/components/brand/Logo.astro";
import { href, ordered, sections } from "@/lib/docs";
import { navLinks, site } from "@/lib/site";

interface Props {
  docs?: boolean;
}

const { docs = false } = Astro.props;
const path = Astro.url.pathname;
const links = navLinks;
const isOn = (h: string) =>
  h === "/docs/" ? path.startsWith("/docs/") && !path.startsWith("/docs/api/") : h.startsWith("/") && path.startsWith(h);
const all = docs ? await ordered() : [];
const socials = [
  ["GitHub", site.repo, GithubIcon, 16],
  ["X", site.x.url, XIcon, 14],
  ["Bluesky", site.bluesky.url, BlueskyIcon, 16],
] as const;
---

<header class:list={["nav", { "nav-docs": docs }]} data-nav>
  <div class="nav-inner">
    <div class="left">
      <a class="logo" href="/" aria-label="Bunzzle home"><Logo /></a>
      <span class="divider">/</span>
      <nav class="links" data-links>
        <span class="highlight" data-highlight></span>
        {links.map(([label, h]) => (
          <a class:list={["link", { on: isOn(h) }]} href={h}>{label}{h.startsWith("http") && <ChevronIcon class="ext" width={10} height={10} aria-hidden="true" />}</a>
        ))}
      </nav>
    </div>
    <div class="right">
      <button type="button" class="ctl search" data-open-search aria-label="Search">
        <SearchIcon width={15} height={15} aria-hidden="true" />
        <span class="search-text">Search...</span>
        <kbd>/</kbd>
      </button>
      <button type="button" class="ctl icon" data-theme-toggle aria-label="Toggle theme">
        <SunIcon class="sun" width={16} height={16} aria-hidden="true" />
        <MoonIcon class="moon" width={16} height={16} aria-hidden="true" />
      </button>
      <a class="ctl icon social" href={site.x.url} aria-label="Bunzzle on X">
        <XIcon width={14} height={14} aria-hidden="true" />
      </a>
      <a class="ctl icon social" href={site.bluesky.url} aria-label="Bunzzle on Bluesky">
        <BlueskyIcon width={16} height={16} aria-hidden="true" />
      </a>
      <a class="ctl github" href={site.repo}>
        <GithubIcon width={15} height={15} aria-hidden="true" />
        <span>Star</span>
      </a>
      <a class="cta" href="/docs/">Get Started</a>
      <button type="button" class="ctl burger" data-burger aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    {!docs && (
      <div class="menu" data-menu hidden>
        {links.map(([label, h]) => <a class="menu-link" href={h}>{label}</a>)}
        <div class="menu-social">
          {socials.map(([label, h, Icon, size]) => (
            <a href={h} aria-label={`Bunzzle on ${label}`}><Icon width={size} height={size} aria-hidden="true" /></a>
          ))}
        </div>
      </div>
    )}
  </div>

  {docs && (
    <div class="sheet" data-menu hidden>
      <div class="sheet-scroll">
        <label class="sheet-filter">
          <SearchIcon width={14} height={14} aria-hidden="true" />
          <input type="search" placeholder={`Filter ${all.length} pages...`} data-sheet-filter />
        </label>
        {sections.map((s) => (
          <div class="sheet-group">
            <span class="sheet-label">{s}</span>
            {all.filter((d) => d.data.section === s).map((d) => (
              <a class:list={["sheet-link", { on: href(d) === path }]} href={href(d)}>{d.data.title}</a>
            ))}
          </div>
        ))}
        <div class="menu-social sheet-social">
          {socials.map(([label, h, Icon, size]) => (
            <a href={h} aria-label={`Bunzzle on ${label}`}><Icon width={size} height={size} aria-hidden="true" /></a>
          ))}
        </div>
      </div>
    </div>
  )}
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const onScroll = () => nav.classList.toggle("scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const linksBox = nav.querySelector<HTMLElement>("[data-links]")!;
  const hl = nav.querySelector<HTMLElement>("[data-highlight]")!;
  for (const a of linksBox.querySelectorAll<HTMLElement>(".link")) {
    a.addEventListener("mouseenter", () => {
      hl.style.width = `${a.offsetWidth}px`;
      hl.style.height = `${a.offsetHeight}px`;
      hl.style.transform = `translate(${a.offsetLeft}px, ${a.offsetTop}px)`;
      hl.style.opacity = "1";
    });
  }
  linksBox.addEventListener("mouseleave", () => (hl.style.opacity = "0"));

  nav.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });

  const burger = nav.querySelector<HTMLButtonElement>("[data-burger]")!;
  const menu = nav.querySelector<HTMLElement>("[data-menu]");
  const setMenu = (open: boolean) => {
    if (!menu) return;
    menu.hidden = !open;
    burger.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("menu-open", open && nav.classList.contains("nav-docs"));
  };
  burger.addEventListener("click", () => setMenu(Boolean(menu?.hidden)));
  addEventListener("keydown", (e) => e.key === "Escape" && setMenu(false));
  addEventListener("click", (e) => {
    if (menu && !menu.hidden && !nav.contains(e.target as Node)) setMenu(false);
  });

  nav.querySelector<HTMLInputElement>("[data-sheet-filter]")?.addEventListener("input", (e) => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    for (const g of nav.querySelectorAll<HTMLElement>(".sheet-group")) {
      let any = false;
      for (const a of g.querySelectorAll<HTMLElement>(".sheet-link")) {
        const hit = !q || (a.textContent ?? "").toLowerCase().includes(q);
        a.hidden = !hit;
        any ||= hit;
      }
      g.hidden = !any;
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 20px;
    left: 0;
    right: 0;
    z-index: 1500;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 24px;
    pointer-events: none;
  }
  .nav-inner {
    position: relative;
    width: 100%;
    max-width: 1680px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px 0 20px;
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    background: transparent;
    pointer-events: auto;
    transition: max-width 0.5s ease, background 0.5s ease, border-color 0.5s ease, padding 0.5s ease, box-shadow 0.5s ease;
  }
  .nav.scrolled .nav-inner {
    max-width: 1276px;
    background: var(--nav-scrolled);
    border-color: var(--nav-edge);
    box-shadow: var(--nav-shadow);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
  }
  .left,
  .right {
    display: flex;
    align-items: center;
  }
  .right {
    gap: 12px;
  }
  .logo {
    display: flex;
    align-items: center;
    color: var(--ink);
  }
  .divider {
    margin: 0 8px 0 18px;
    color: var(--ink);
    font-size: 18px;
    font-weight: 300;
    user-select: none;
  }
  .links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .highlight {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 12px;
    background: var(--nav-scrolled);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.2), inset 0 0.5px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(24px) saturate(1.4);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s ease, width 0.3s ease, height 0.3s ease, opacity 0.2s ease;
  }
  :global(:root[data-theme="light"]) .highlight {
    background: #fff;
    border-color: var(--line);
    box-shadow: none;
  }
  .link {
    position: relative;
    z-index: 1;
    padding: 6px 10px;
    border-radius: 12px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: color var(--t-fast), transform var(--dur-press) var(--ease-out);
  }
  .link:active {
    transform: scale(0.96);
  }
  .ext {
    margin-left: 3px;
    color: var(--faint);
  }
  .link.on {
    box-shadow: inset 0 0 0 1px var(--shell-border-strong);
    background: var(--ghost-track);
  }
  .ctl {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid var(--control-border);
    background: var(--control-bg);
    box-shadow: var(--control-shadow);
    backdrop-filter: var(--ghost-blur);
    -webkit-backdrop-filter: var(--ghost-blur);
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--t-fast), color var(--t-fast), transform var(--dur-press) var(--ease-out);
  }
  .ctl:hover {
    background: var(--control-hover);
  }
  .ctl:active {
    transform: scale(0.97);
  }
  .search {
    gap: 8px;
    padding: 0 9px 0 14px;
    color: var(--dim);
  }
  .search-text {
    margin-right: 8px;
    font-size: 12px;
  }
  kbd {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border: 1px solid var(--shell-border-strong);
    border-radius: 4px;
    background: var(--control-bg);
    color: var(--dim);
    font: 700 10px var(--font-code);
  }
  .icon {
    width: 36px;
    padding: 0;
    justify-content: center;
    color: var(--ink);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: block;
  }
  :global(:root[data-theme="light"]) .github svg,
  :global(:root[data-theme="light"]) .social svg {
    color: #77726a;
  }
  .cta {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    height: 36px;
    padding: 0 18px;
    border-radius: 10px;
    background: var(--honey-2);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 1px 2px rgba(0, 0, 0, 0.2);
    color: var(--honey-ink);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: filter var(--t-fast), transform var(--dur-press) var(--ease-out);
  }
  .cta:hover {
    filter: brightness(1.08);
  }
  .cta:active {
    transform: scale(0.97);
  }
  .burger {
    display: none;
  }
  .burger {
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    padding: 9px;
  }
  .burger span {
    display: block;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: var(--ink);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .burger.open span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .burger.open span:nth-child(2) {
    opacity: 0;
  }
  .burger.open span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }
  .menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 5px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 200px;
    padding: 8px;
    border-radius: 14px;
    border: 1px solid var(--shell-border);
    background: var(--menu-bg);
    backdrop-filter: blur(32px) saturate(1.3);
    -webkit-backdrop-filter: blur(32px) saturate(1.3);
    box-shadow: var(--menu-shadow);
    animation: menu-in 0.2s ease;
  }
  .menu[hidden],
  .sheet[hidden] {
    display: none;
  }
  .menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .menu-link::after {
    content: "→";
    font-size: 16px;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .menu-link:hover {
    background: var(--ghost);
    color: var(--ink);
  }
  .menu-link:hover::after {
    opacity: 1;
    transform: none;
  }
  .menu-social {
    display: flex;
    gap: 4px;
    margin-top: 6px;
    padding: 8px 6px 2px;
    border-top: 1px solid var(--shell-border);
  }
  .menu-social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--muted);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .menu-social a:hover {
    background: var(--ghost);
    color: var(--ink);
  }
  .sheet-social {
    justify-content: center;
    margin-top: 24px;
    padding-top: 16px;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .nav-docs {
    top: 0;
    padding: 0;
  }
  .nav-docs .nav-inner,
  .nav-docs.scrolled .nav-inner {
    max-width: 100%;
    height: var(--docs-header);
    padding: 0 2em;
    border-radius: 0;
    border-color: transparent;
    border-bottom: 1px solid var(--shell-border);
    box-shadow: none;
  }
  .nav-docs .nav-inner {
    background: var(--bg);
  }
  .nav-docs.scrolled .nav-inner {
    background: color-mix(in srgb, var(--shell-solid) 85%, transparent);
  }
  .sheet {
    position: fixed;
    top: var(--docs-header);
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    background: var(--shell-solid);
    pointer-events: auto;
    animation: fade-in 0.2s ease;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  .sheet-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 14px 14px 24px;
  }
  .sheet-filter {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    margin-bottom: 10px;
    padding: 0 11px;
    border: 1px solid var(--shell-border-strong);
    border-radius: 9px;
    background: var(--field);
    color: var(--dim);
  }
  .sheet-filter input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font-size: 13px;
  }
  .sheet-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 14px;
  }
  .sheet-label {
    padding: 0 10px;
    margin-bottom: 5px;
    color: var(--dim);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .sheet-link {
    display: flex;
    align-items: center;
    min-height: 32px;
    padding: 6px 9px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 13px;
  }
  .sheet-link.on {
    background: var(--ghost);
    color: var(--ink);
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
  @media (max-width: 900px) and (min-width: 769px) {
    .nav:not(.nav-docs) .search {
      display: none;
    }
    .right {
      gap: 8px;
    }
  }
  @media (max-width: 768px) {
    .nav {
      padding: 0 16px;
    }
    .nav-inner {
      max-width: 100%;
      padding: 0 5px 0 16px;
      border-radius: 16px;
    }
    .nav.scrolled .nav-inner {
      max-width: 100%;
    }
    .links,
    .divider,
    .social,
    .github,
    .search-text,
    .search kbd {
      display: none;
    }
    .nav:not(.nav-docs) .search {
      display: none;
    }
    .search {
      padding: 0 10px;
    }
    .right {
      gap: 8px;
    }
    .cta {
      height: 32px;
      padding: 0 12px;
      border-radius: 8px;
      font-size: 12px;
    }
    .nav-docs .cta {
      display: none;
    }
    .burger {
      display: flex;
    }
    .nav-docs .nav-inner,
    .nav-docs.scrolled .nav-inner {
      padding: 0 16px;
    }
  }
</style>
