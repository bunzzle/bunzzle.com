---
import ArrowIcon from "@/assets/icons/arrow-right.svg";
import { links, site } from "@/lib/site";
---

<div class="help">
  <span class="title">Need a hand?</span>
  <p>Something unclear or broken? Open an issue, or write to us.</p>
  <a href={links.issues}>Open an issue <ArrowIcon width={14} height={14} aria-hidden="true" /></a>
  <a href={`mailto:${site.email}`}>{site.email} <ArrowIcon width={14} height={14} aria-hidden="true" /></a>
</div>

<style>
  .help {
    padding: 16px;
    border: 1px solid var(--shell-border);
    border-radius: 16px;
    background: color-mix(in srgb, var(--shell-solid) 78%, transparent);
  }
  .title {
    display: block;
    margin-bottom: 10px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }
  p {
    margin: 0 0 12px;
    color: var(--dim);
    font-size: 12.5px;
    line-height: 1.5;
  }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    color: var(--accent);
    font-size: 12.5px;
  }
</style>
