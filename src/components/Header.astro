---
import logo from "../assets/bunzzle.svg";
---

<header class="wrap">
  <a class="brand" href="/">
    <img src={logo.src} alt="" width="28" height="28" />
    <span>Bunzzle</span>
  </a>
  <nav>
    <a href="/docs/">Docs</a>
    <a href="https://github.com/bunzzle/bunzzle">GitHub</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.03em;
  }
  .brand img {
    height: 28px;
    width: auto;
  }
  nav {
    display: flex;
    gap: 24px;
    font-size: 14px;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--fg);
  }
</style>
