---
import raw from "@/assets/bunzzle.svg?raw";

const [left, right, shade, bunny] = [...raw.matchAll(/<path [^>]+\/>/g)].map((m) => m[0]);
const gradients = (raw.match(/<defs>([\s\S]*?)<\/defs>/)?.[1] ?? "").replace(/id="(\w+)"/g, 'id="bz-$1"');
const fill = (p: string) => p.replace(/url\(#(\w+)\)/g, "url(#bz-$1)");

const far = "M150 100L560 100L572 289L610 356L636 400L652 426L617 511L150 511Z";
const up = "M560 100L840 100L840 400L740 436L728 441L690 438L652 426L636 400L610 356L572 289Z";
const farClip = "M150 100L560 100L572 289L610 356L636 400L652 426L650 446L625 524L150 524Z";
const upClip = "M560 100L840 100L840 410L742 446L728 451L690 448L652 436L652 426L636 400L610 356L572 289Z";

const defs =
  gradients +
  fill(bunny).replace("<path ", '<path id="bz-b" ') +
  `<clipPath id="bz-far"><path d="${farClip}"/></clipPath>` +
  `<clipPath id="bz-up"><path d="${upClip}"/></clipPath>` +
  `<clipPath id="bz-body"><path clip-rule="evenodd" d="M100 100H1100V1200H100Z${far}${up}"/></clipPath>`;

const ear = (x: number, y: number, cls: string, clip: string) =>
  `<g transform="translate(${x} ${y})"><g class="ear sway-${cls}"><g class="ear ${cls}"><g transform="translate(${-x} ${-y})"><g clip-path="url(#${clip})"><use href="#bz-b"/></g></g></g></g></g>`;

const svg =
  `<svg viewBox="216 112 821 1031" aria-hidden="true"><defs>${defs}</defs>` +
  fill(left + right + shade) +
  ear(635, 470, "far", "bz-far") +
  ear(690, 436, "up", "bz-up") +
  `<g clip-path="url(#bz-body)"><use href="#bz-b"/></g></svg>`;
---

<div class="mark" role="img" aria-label="Bunzzle" set:html={svg} />

<style>
  .mark {
    width: 132px;
    aspect-ratio: 821 / 1031;
  }
  .mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .mark :global(.ear) {
    transform-box: view-box;
    transform-origin: 0 0;
  }
  .mark :global(.sway-up) {
    animation: sway-up 3.2s ease-in-out infinite alternate;
  }
  .mark :global(.sway-far) {
    animation: sway-far 3.9s ease-in-out infinite alternate;
  }
  .mark :global(.up) {
    animation: up 5s ease-in-out 0.5s infinite;
  }
  .mark :global(.far) {
    animation: far 6.3s ease-in-out 0.58s infinite;
  }
  .mark:hover :global(.up) {
    animation: flick-up 1.1s ease-in-out;
  }
  .mark:hover :global(.far) {
    animation: flick-far 1.1s ease-in-out 0.08s;
  }
  @keyframes sway-up {
    from {
      transform: skewX(-1.2deg);
    }
    to {
      transform: skewX(1.2deg);
    }
  }
  @keyframes sway-far {
    from {
      transform: skewY(1deg);
    }
    to {
      transform: skewY(-0.8deg);
    }
  }
  @keyframes up {
    0% {
      transform: none;
    }
    3.5% {
      transform: skewX(16deg);
    }
    7.7% {
      transform: skewX(-10deg);
    }
    11.2% {
      transform: skewX(6deg);
    }
    14.7% {
      transform: skewX(-3.5deg);
    }
    18.2% {
      transform: skewX(1.5deg);
    }
    21.7%,
    55% {
      transform: none;
    }
    57.8% {
      transform: skewX(7deg);
    }
    61.3% {
      transform: skewX(-3deg);
    }
    64.8%,
    100% {
      transform: none;
    }
  }
  @keyframes far {
    0% {
      transform: none;
    }
    3.3% {
      transform: skewY(8deg);
    }
    7.2% {
      transform: skewY(-5deg);
    }
    10.6% {
      transform: skewY(2.5deg);
    }
    13.9% {
      transform: skewY(-1deg);
    }
    17.2%,
    60% {
      transform: none;
    }
    62.5% {
      transform: skewY(4deg);
    }
    65% {
      transform: skewY(-2deg);
    }
    67.5%,
    100% {
      transform: none;
    }
  }
  @keyframes flick-up {
    0%,
    100% {
      transform: none;
    }
    16% {
      transform: skewX(16deg);
    }
    36% {
      transform: skewX(-10deg);
    }
    52% {
      transform: skewX(6deg);
    }
    68% {
      transform: skewX(-3.5deg);
    }
    84% {
      transform: skewX(1.5deg);
    }
  }
  @keyframes flick-far {
    0%,
    100% {
      transform: none;
    }
    20% {
      transform: skewY(8deg);
    }
    42% {
      transform: skewY(-5deg);
    }
    62% {
      transform: skewY(2.5deg);
    }
    82% {
      transform: skewY(-1deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark :global(.ear) {
      animation: none;
    }
  }
</style>
